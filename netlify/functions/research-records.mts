const URL=process.env.SUPABASE_URL,KEY=process.env.SUPABASE_SERVICE_ROLE_KEY,ADMIN=process.env.CROPSMART_RESEARCH_ADMIN_KEY
const h=()=>({apikey:KEY!,Authorization:`Bearer ${KEY}`,'Content-Type':'application/json',Prefer:'return=representation'})
async function db(path:string,init:RequestInit={}){if(!URL||!KEY)throw new Error('Server database is not configured.');const r=await fetch(`${URL}/rest/v1/${path}`,{...init,headers:{...h(),...(init.headers||{})}});const t=await r.text();if(!r.ok)throw new Error(t);return t?JSON.parse(t):null}
export default async(req:Request)=>{if(!ADMIN||req.headers.get('x-cropsmart-admin-key')!==ADMIN)return new Response(JSON.stringify({error:'Unauthorized'}),{status:401});try{const u=new URL(req.url),resource=u.searchParams.get('resource')||'observations',limit=Math.min(Number(u.searchParams.get('limit')||100),1000),tables:Record<string,string>={observations:'cs_observations',experiments:'cs_experiments',audit:'cs_audit_log',quarantine:'cs_quarantine',heartbeats:'cs_device_heartbeats',ingestion:'cs_ingestion_messages',sensors:'cs_sensors'};const table=tables[resource];if(!table)return new Response(JSON.stringify({error:'Unknown resource'}),{status:400});if(req.method==='GET'){const rows=await db(`${table}?select=*&limit=${limit}&order=${resource==='observations'?'observed_at':resource==='heartbeats'?'last_seen_at':'created_at'}.desc`);return Response.json({resource,records:rows})}if(req.method==='POST'&&resource==='experiments'){const x=await req.json();if(!x.id||!x.reproducibilityKey)return new Response(JSON.stringify({error:'Experiment id and reproducibilityKey required'}),{status:400});const rows=await db('cs_experiments?on_conflict=id',{method:'POST',headers:{Prefer:'resolution=merge-duplicates,return=representation'},body:JSON.stringify({id:x.id,title:x.title||x.id,state_id:x.stateId||null,evidence_mode:x.evidenceMode||null,model_versions:x.modelVersions||{},parameter_versions:x.parameterVersions||{},lineage:x.lineage||[],reproducibility_key:x.reproducibilityKey,manifest:x})});await db('cs_audit_log',{method:'POST',body:JSON.stringify({actor_type:'RESEARCHER',action:'EXPERIMENT_UPSERT',entity_type:'EXPERIMENT',entity_id:x.id,details:{reproducibilityKey:x.reproducibilityKey}})});return Response.json(rows[0],{status:201})}return new Response(JSON.stringify({error:'Method not allowed'}),{status:405})}catch(e){return new Response(JSON.stringify({error:e instanceof Error?e.message:'Server error'}),{status:500})}}
