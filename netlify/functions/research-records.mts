const URL=process.env.SUPABASE_URL,KEY=process.env.SUPABASE_SERVICE_ROLE_KEY,ADMIN=process.env.CROPSMART_RESEARCH_ADMIN_KEY
const h=()=>({apikey:KEY!,Authorization:`Bearer ${KEY}`,'Content-Type':'application/json',Prefer:'return=representation'})
async function db(path:string,init:RequestInit={}){if(!URL||!KEY)throw new Error('Server database is not configured.');const r=await fetch(`${URL}/rest/v1/${path}`,{...init,headers:{...h(),...(init.headers||{})}});const t=await r.text();if(!r.ok)throw new Error(t);return t?JSON.parse(t):null}
const resources:Record<string,{table:string,order:string}>={observations:{table:'cs_observations',order:'observed_at'},experiments:{table:'cs_experiments',order:'created_at'},audit:{table:'cs_audit_log',order:'occurred_at'},quarantine:{table:'cs_quarantine',order:'received_at'},heartbeats:{table:'cs_device_heartbeats',order:'last_seen_at'},ingestion:{table:'cs_ingestion_messages',order:'received_at'},sensors:{table:'cs_sensors',order:'created_at'}}
export default async(req:Request)=>{if(!ADMIN||req.headers.get('x-cropsmart-admin-key')!==ADMIN)return new Response(JSON.stringify({error:'Unauthorized'}),{status:401,headers:{'Content-Type':'application/json'}});try{const u=new URL(req.url),resource=u.searchParams.get('resource')||'observations',rawLimit=Number(u.searchParams.get('limit')||100),limit=Number.isFinite(rawLimit)?Math.max(1,Math.min(rawLimit,1000)):100,config=resources[resource];if(!config)return new Response(JSON.stringify({error:'Unknown resource'}),{status:400,headers:{'Content-Type':'application/json'}});if(req.method==='GET'){const rows=await db(`${config.table}?select=*&limit=${limit}&order=${config.order}.desc`);return Response.json({resource,records:rows})}if(req.method==='POST'&&resource==='experiments'){const x=await req.json();if(!x.id||!x.reproducibilityKey)return new Response(JSON.stringify({error:'Experiment id and reproducibilityKey required'}),{status:400,headers:{'Content-Type':'application/json'}});const rows=await db('cs_experiments?on_conflict=id',{method:'POST',headers:{Prefer:'resolution=merge-duplicates,return=representation'},body:JSON.stringify({id:x.id,title:x.title||x.id,state_id:x.stateId||null,evidence_mode:x.evidenceMode||null,model_versions:x.modelVersions||{},parameter_versions:x.parameterVersions||{},lineage:x.lineage||[],reproducibility_key:x.reproducibilityKey,manifest:x})});await db('cs_audit_log',{method:'POST',body:JSON.stringify({actor_type:'RESEARCHER',action:'EXPERIMENT_UPSERT',entity_type:'EXPERIMENT',entity_id:x.id,details:{reproducibilityKey:x.reproducibilityKey}})});return Response.json(rows[0],{status:201})}return new Response(JSON.stringify({error:'Method not allowed'}),{status:405,headers:{'Content-Type':'application/json'}})}catch(e){return new Response(JSON.stringify({error:e instanceof Error?e.message:'Server error'}),{status:500,headers:{'Content-Type':'application/json'}})}}
