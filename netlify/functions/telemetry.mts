import {createHash,timingSafeEqual} from 'node:crypto'
const URL=process.env.SUPABASE_URL,KEY=process.env.SUPABASE_SERVICE_ROLE_KEY
const headers=()=>({apikey:KEY!,Authorization:`Bearer ${KEY}`,'Content-Type':'application/json',Prefer:'return=representation'})
async function db(path:string,init:RequestInit={}){if(!URL||!KEY)throw new Error('Server database is not configured.');const r=await fetch(`${URL}/rest/v1/${path}`,{...init,headers:{...headers(),...(init.headers||{})}});const text=await r.text();if(!r.ok)throw new Error(`Database ${r.status}: ${text}`);return text?JSON.parse(text):null}
const hash=(v:string)=>createHash('sha256').update(v).digest('hex');const same=(a:string,b:string)=>{const x=Buffer.from(a),y=Buffer.from(b);return x.length===y.length&&timingSafeEqual(x,y)}
async function quarantine(payload:unknown,reason:string,deviceId?:string,messageId?:string){await db('cs_quarantine',{method:'POST',body:JSON.stringify({payload,reason,device_id:deviceId,message_id:messageId})})}
export default async(req:Request)=>{if(req.method!=='POST')return new Response(JSON.stringify({error:'Method not allowed'}),{status:405,headers:{'content-type':'application/json'}});let body:any;try{body=await req.json()}catch{return new Response(JSON.stringify({error:'Invalid JSON'}),{status:400})}const deviceId=body?.deviceId,messageId=body?.messageId,secret=req.headers.get('x-cropsmart-device-key')||'';if(!deviceId||!messageId||!body?.sentAt||!Array.isArray(body?.points)){await quarantine(body,'Malformed telemetry envelope.',deviceId,messageId).catch(()=>{});return new Response(JSON.stringify({error:'Malformed telemetry envelope'}),{status:400})}try{const keys=await db(`cs_device_keys?device_id=eq.${encodeURIComponent(deviceId)}&revoked=eq.false&select=id,key_hash`);const supplied=hash(secret),match=keys.find((k:any)=>same(k.key_hash,supplied));if(!match){await quarantine(body,'Device authentication failed.',deviceId,messageId);return new Response(JSON.stringify({error:'Unauthorized'}),{status:401})}const prior=await db(`cs_ingestion_messages?message_id=eq.${encodeURIComponent(messageId)}&select=*`);if(prior.length)return new Response(JSON.stringify({status:'DUPLICATE',ingestion:prior[0]}),{status:200,headers:{'content-type':'application/json'}});const sensors=await db(`cs_sensors?id=in.(${body.points.map((p:any)=>`"${String(p.sensorId).replaceAll('"','')}"`).join(',')})&active=eq.true&select=*`),map=new Map(sensors.map((s:any)=>[s.id,s]));const accepted:any[]=[],rejected:string[]=[];for(const p of body.points){const s:any=map.get(p.sensorId);if(!s){rejected.push(`${p.sensorId}: unregistered sensor`);continue}if(s.variable!==p.variable||s.unit!==p.unit){rejected.push(`${p.sensorId}: variable/unit binding mismatch`);continue}if(!Number.isFinite(p.value)||!Number.isFinite(Date.parse(p.timestamp))){rejected.push(`${p.sensorId}: invalid value/timestamp`);continue}accepted.push({farm_id:s.farm_id,zone_id:s.zone_id,sensor_id:s.id,variable:p.variable,value:p.value,unit:p.unit,observed_at:p.timestamp,provenance:'MEASURED',quality:'PASS',source_name:`Telemetry:${deviceId}`,source_dataset:messageId,uncertainty:p.uncertainty??null,note:`Transport ${body.transport||'HTTP'}`})}const received=new Date(),sent=new Date(body.sentAt),drift=(received.getTime()-sent.getTime())/1000,status=!accepted.length?'QUARANTINED':rejected.length?'PARTIAL':'ACCEPTED';const ing=(await db('cs_ingestion_messages',{method:'POST',body:JSON.stringify({device_id:deviceId,message_id:messageId,sent_at:body.sentAt,transport:body.transport||'HTTP',status,point_count:body.points.length,accepted_count:accepted.length,rejected_count:rejected.length,clock_drift_seconds:drift,messages:rejected})}))[0];if(accepted.length)await db('cs_observations?on_conflict=sensor_id,variable,observed_at,source_dataset',{method:'POST',headers:{Prefer:'resolution=ignore-duplicates,return=representation'},body:JSON.stringify(accepted.map(x=>({...x,ingestion_id:ing.id}))) });if(rejected.length)await quarantine(body,rejected.join('; '),deviceId,messageId);await db('cs_device_heartbeats?on_conflict=device_id',{method:'POST',headers:{Prefer:'resolution=merge-duplicates,return=minimal'},body:JSON.stringify({device_id:deviceId,last_seen_at:received.toISOString(),last_sent_at:body.sentAt,transport:body.transport||'HTTP',clock_drift_seconds:drift,updated_at:received.toISOString()})});await db(`cs_device_keys?id=eq.${match.id}`,{method:'PATCH',body:JSON.stringify({last_used_at:received.toISOString()})});await db('cs_audit_log',{method:'POST',body:JSON.stringify({actor_type:'DEVICE',actor_id:deviceId,action:'TELEMETRY_INGEST',entity_type:'INGESTION_MESSAGE',entity_id:ing.id,details:{messageId,status,accepted:accepted.length,rejected:rejected.length}})});return new Response(JSON.stringify({status,ingestionId:ing.id,accepted:accepted.length,rejected:rejected.length,clockDriftSeconds:drift,messages:rejected}),{status:accepted.length?202:422,headers:{'content-type':'application/json'}})}catch(e){return new Response(JSON.stringify({error:e instanceof Error?e.message:'Server error'}),{status:500,headers:{'content-type':'application/json'}})}}
