const URL=process.env.SUPABASE_URL
const KEY=process.env.SUPABASE_SERVICE_ROLE_KEY
const ADMIN=process.env.CROPSMART_RESEARCH_ADMIN_KEY
const resources:Record<string,{table:string,order:string}>={places:{table:'cfew_places',order:'created_at'},stakeholders:{table:'cfew_stakeholders',order:'created_at'},preferences:{table:'cfew_stakeholder_preferences',order:'created_at'},resilienceScenarios:{table:'cfew_resilience_scenarios',order:'created_at'},resilienceResults:{table:'cfew_resilience_results',order:'created_at'},economicCases:{table:'cfew_economic_cases',order:'created_at'},economicResults:{table:'cfew_economic_results',order:'created_at'}}
const headers=()=>({apikey:KEY!,Authorization:`Bearer ${KEY}`,'Content-Type':'application/json',Prefer:'return=representation'})
async function db(path:string,init:RequestInit={}){if(!URL||!KEY)throw new Error('Research database is not configured.');const r=await fetch(`${URL}/rest/v1/${path}`,{...init,headers:{...headers(),...(init.headers||{})}});const t=await r.text();if(!r.ok)throw new Error(t);return t?JSON.parse(t):null}
export default async(req:Request)=>{if(!ADMIN||req.headers.get('x-cropsmart-admin-key')!==ADMIN)return Response.json({error:'Unauthorized'},{status:401});try{const u=new URL(req.url),resource=u.searchParams.get('resource')||'',config=resources[resource];if(!config)return Response.json({error:'Unknown CHIPU-FEW domain resource'},{status:400});const farmId=u.searchParams.get('farmId');if(req.method==='GET'){const filter=farmId&&['places','stakeholders','resilienceScenarios','economicCases'].includes(resource)?`&farm_id=eq.${encodeURIComponent(farmId)}`:'';const rows=await db(`${config.table}?select=*&order=${config.order}.desc${filter}`);return Response.json({resource,records:rows})}if(req.method==='POST'){const body=await req.json();if(!body||typeof body!=='object')return Response.json({error:'JSON object required'},{status:400});const rows=await db(config.table,{method:'POST',body:JSON.stringify(body)});return Response.json(rows?.[0]??rows,{status:201})}return Response.json({error:'Method not allowed'},{status:405})}catch(e){return Response.json({error:e instanceof Error?e.message:'Server error'},{status:500})}}
